# Firebase Configuration
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
VITE_FIREBASE_SENDERID="your-private-key-here"
VITE_FIREBASE_STORAGE="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_SENDERID="your-sender-id"

# Email Configuration
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# OpenRouter AI Configuration (Free AI Models)
# Get your FREE API key from: https://openrouter.ai/keys
# Used for: ChatBot Assistant, Nigeria Curriculum, and other AI features
# Models: 100+ free AI models including GPT, Claude, Llama, Gemini
# Cost: $0.00 (completely free with generous rate limits)
VITE_OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Legacy OpenAI Configuration (Optional - not used anymore)
# OpenRouter is now the default AI provider
# AI="your-openai-api-key"
# VITE_OPENAI_API_KEY="your-openai-api-key"
